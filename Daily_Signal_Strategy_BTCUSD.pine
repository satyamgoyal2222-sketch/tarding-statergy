//@version=6
indicator("Daily Signal Strategy - BTCUSD v4 Final", overlay=true)

// ====================================================================
// COMPLETE TRADING STRATEGY WITH DAILY CANDLE COLOR LOGIC
// Entry: Daily Close ± 250 (Updates Every Day)
// SL: 250 points | Target: 2500 points
// Break Even: 2000 points OR Daily Candle Color Reversal
// ====================================================================

// INPUTS
targetPoints = input.float(2500, "Target Profit Points", group="Settings")
stopLossPoints = input.float(250, "Stop Loss Points", group="Settings")
breakEvenThreshold = input.float(2000, "Break Even Threshold Points", group="Settings")
showLabels = input.bool(true, "Show Entry Levels", group="Display")

// FIXED ENTRY OFFSET (NOT ADJUSTABLE)
const float ENTRY_OFFSET = 250

// GET DAILY DATA
dailyClose = request.security(syminfo.tickerid, "D", close)
dailyOpen = request.security(syminfo.tickerid, "D", open)
dailyCloseYesterday = request.security(syminfo.tickerid, "D", close[1])
dailyOpenYesterday = request.security(syminfo.tickerid, "D", open[1])

// DETERMINE TODAY'S CANDLE COLOR
isBullishToday = dailyClose > dailyOpen  // Today GREEN
isBearishToday = dailyClose < dailyOpen  // Today RED

// DETERMINE YESTERDAY'S CANDLE COLOR (for trade reference)
isBullishYesterday = dailyCloseYesterday > dailyOpenYesterday  // Yesterday GREEN
isBearishYesterday = dailyCloseYesterday < dailyOpenYesterday  // Yesterday RED

// CALCULATE TODAY'S ENTRY LEVEL (UPDATES EVERY DAY)
entryLevel = isBullishToday ? dailyClose + ENTRY_OFFSET : dailyClose - ENTRY_OFFSET

// ====================================================================
// TRADE STATE MANAGEMENT
// ====================================================================

var bool tradeActive = false
var string tradeType = na              // "BUY" or "SELL"
var float tradeEntryPrice = na
var float tradeTargetPrice = na
var float tradeStopLossPrice = na
var float tradeCurrentProfit = 0.0
var string entryDayColor = na          // Color of candle when trade entered
var int tradeBarIndex = na

// BACKTESTING VARIABLES
var int totalTrades = 0
var int winningTrades = 0
var int losingTrades = 0
var int ctcTrades = 0                  // Cost to Cost trades
var float totalProfit = 0.0
var float largestWin = 0.0
var float largestLoss = 0.0

// ====================================================================
// TRADE ENTRY LOGIC
// ====================================================================

// Check if price reached today's entry level (and NO active trade)
shouldEnterBuy = isBullishToday and close >= entryLevel and close[1] < entryLevel and not tradeActive
shouldEnterSell = isBearishToday and close <= entryLevel and close[1] > entryLevel and not tradeActive

// BUY TRADE ENTRY (GREEN Candle Entry)
if shouldEnterBuy
    tradeActive := true
    tradeType := "BUY"
    tradeEntryPrice := entryLevel
    tradeTargetPrice := entryLevel + targetPoints
    tradeStopLossPrice := entryLevel - stopLossPoints
    entryDayColor := "GREEN"
    tradeBarIndex := bar_index
    tradeCurrentProfit := 0.0
    alert("🟢 BUY SIGNAL TRIGGERED\nEntry: " + str.tostring(tradeEntryPrice, format.price) + "\nTarget: " + str.tostring(tradeTargetPrice, format.price) + "\nStop Loss: " + str.tostring(tradeStopLossPrice, format.price) + "\nCandle Color: GREEN")

// SELL TRADE ENTRY (RED Candle Entry)
if shouldEnterSell
    tradeActive := true
    tradeType := "SELL"
    tradeEntryPrice := entryLevel
    tradeTargetPrice := entryLevel - targetPoints
    tradeStopLossPrice := entryLevel + stopLossPoints
    entryDayColor := "RED"
    tradeBarIndex := bar_index
    tradeCurrentProfit := 0.0
    alert("🔴 SELL SIGNAL TRIGGERED\nEntry: " + str.tostring(tradeEntryPrice, format.price) + "\nTarget: " + str.tostring(tradeTargetPrice, format.price) + "\nStop Loss: " + str.tostring(tradeStopLossPrice, format.price) + "\nCandle Color: RED")

// ====================================================================
// TRACK CURRENT PROFIT/LOSS
// ====================================================================

if tradeActive
    if tradeType == "BUY"
        tradeCurrentProfit := close - tradeEntryPrice
    else if tradeType == "SELL"
        tradeCurrentProfit := tradeEntryPrice - close

// ====================================================================
// SCENARIO 1: BREAK EVEN at 2000 POINTS PROFIT
// ====================================================================

var bool breakEvenSet = false

if tradeActive and not breakEvenSet
    if tradeCurrentProfit >= breakEvenThreshold
        breakEvenSet := true
        tradeStopLossPrice := tradeEntryPrice
        alert("⚠️ BREAK EVEN SET - 2000 POINTS REACHED\nStop Loss moved to Entry: " + str.tostring(tradeEntryPrice, format.price))

// ====================================================================
// SCENARIO 2: BREAK EVEN ON DAILY CANDLE COLOR REVERSAL
// ====================================================================

if tradeActive and not breakEvenSet
    // BUY trade entered on GREEN candle, but today closes RED
    if tradeType == "BUY" and entryDayColor == "GREEN" and isBearishToday
        breakEvenSet := true
        tradeStopLossPrice := tradeEntryPrice
        alert("⚠️ BREAK EVEN SET - CANDLE COLOR REVERSAL\nEntry was GREEN, Today is RED\nStop Loss moved to Entry: " + str.tostring(tradeEntryPrice, format.price))
    
    // SELL trade entered on RED candle, but today closes GREEN
    if tradeType == "SELL" and entryDayColor == "RED" and isBullishToday
        breakEvenSet := true
        tradeStopLossPrice := tradeEntryPrice
        alert("⚠️ BREAK EVEN SET - CANDLE COLOR REVERSAL\nEntry was RED, Today is GREEN\nStop Loss moved to Entry: " + str.tostring(tradeEntryPrice, format.price))

// Reset breakEvenSet when trade closes
if not tradeActive
    breakEvenSet := false

// ====================================================================
// CHECK FOR TARGET HIT (Trade Completed - Full Profit)
// ====================================================================

if tradeActive and tradeType == "BUY" and close >= tradeTargetPrice
    profitPoints = targetPoints
    totalProfit += profitPoints
    winningTrades += 1
    totalTrades += 1
    largestWin := math.max(largestWin, profitPoints)
    
    alert("✅ TARGET HIT - BUY TRADE CLOSED\nEntry: " + str.tostring(tradeEntryPrice, format.price) + "\nExit: " + str.tostring(close, format.price) + "\nProfit: " + str.tostring(profitPoints, format.price) + " points\n\n✓ NEXT TRADE CAN START")
    tradeActive := false
    tradeType := na
    tradeEntryPrice := na
    entryDayColor := na

if tradeActive and tradeType == "SELL" and close <= tradeTargetPrice
    profitPoints = targetPoints
    totalProfit += profitPoints
    winningTrades += 1
    totalTrades += 1
    largestWin := math.max(largestWin, profitPoints)
    
    alert("✅ TARGET HIT - SELL TRADE CLOSED\nEntry: " + str.tostring(tradeEntryPrice, format.price) + "\nExit: " + str.tostring(close, format.price) + "\nProfit: " + str.tostring(profitPoints, format.price) + " points\n\n✓ NEXT TRADE CAN START")
    tradeActive := false
    tradeType := na
    tradeEntryPrice := na
    entryDayColor := na

// ====================================================================
// CHECK FOR STOP LOSS HIT (Trade Completed - Loss)
// ====================================================================

if tradeActive and tradeType == "BUY" and close <= tradeStopLossPrice
    lossPoints = -stopLossPoints
    totalProfit += lossPoints
    losingTrades += 1
    totalTrades += 1
    largestLoss := math.min(largestLoss, lossPoints)
    
    isCTC = breakEvenSet ? " (COST-TO-COST)" : ""
    if breakEvenSet
        ctcTrades += 1
    
    alert("❌ STOP LOSS HIT - BUY TRADE CLOSED" + isCTC + "\nEntry: " + str.tostring(tradeEntryPrice, format.price) + "\nExit: " + str.tostring(close, format.price) + "\nLoss: " + str.tostring(stopLossPoints, format.price) + " points\n\n✓ NEXT TRADE CAN START")
    tradeActive := false
    tradeType := na
    tradeEntryPrice := na
    entryDayColor := na

if tradeActive and tradeType == "SELL" and close >= tradeStopLossPrice
    lossPoints = -stopLossPoints
    totalProfit += lossPoints
    losingTrades += 1
    totalTrades += 1
    largestLoss := math.min(largestLoss, lossPoints)
    
    isCTC = breakEvenSet ? " (COST-TO-COST)" : ""
    if breakEvenSet
        ctcTrades += 1
    
    alert("❌ STOP LOSS HIT - SELL TRADE CLOSED" + isCTC + "\nEntry: " + str.tostring(tradeEntryPrice, format.price) + "\nExit: " + str.tostring(close, format.price) + "\nLoss: " + str.tostring(stopLossPoints, format.price) + " points\n\n✓ NEXT TRADE CAN START")
    tradeActive := false
    tradeType := na
    tradeEntryPrice := na
    entryDayColor := na

// ====================================================================
// DISPLAY ENTRY LEVEL (TODAY'S ENTRY PRICE)
// ====================================================================

if showLabels
    // Draw today's entry level line
    line.new(bar_index - 100, entryLevel, bar_index + 100, entryLevel,
        color=isBullishToday ? color.new(color.green, 30) : color.new(color.red, 30),
        width=2, style=line.style_dashed, extend=extend.right)
    
    // Label for today's entry
    labelText = isBullishToday ? "🟢 TODAY BUY ENTRY: " + str.tostring(entryLevel, format.price) : 
                                "🔴 TODAY SELL ENTRY: " + str.tostring(entryLevel, format.price)
    
    label.new(bar_index + 50, entryLevel + (high * 0.002), labelText,
        color=isBullishToday ? color.new(color.green, 0) : color.new(color.red, 0),
        textcolor=color.white, style=label.style_label_left, size=size.small)

// ====================================================================
// DISPLAY ACTIVE TRADE LEVELS
// ====================================================================

if tradeActive
    // Entry Line (YELLOW - LOCKED PRICE)
    line.new(bar_index - 50, tradeEntryPrice, bar_index + 100, tradeEntryPrice,
        color=color.new(color.yellow, 10), width=4, style=line.style_solid, extend=extend.right)
    
    // Target Line (GREEN)
    line.new(bar_index - 50, tradeTargetPrice, bar_index + 100, tradeTargetPrice,
        color=color.new(color.green, 10), width=3, style=line.style_dotted, extend=extend.right)
    
    // Stop Loss Line (RED)
    line.new(bar_index - 50, tradeStopLossPrice, bar_index + 100, tradeStopLossPrice,
        color=color.new(color.red, 10), width=3, style=line.style_dotted, extend=extend.right)
    
    // Entry label
    label.new(bar_index, tradeEntryPrice + (high * 0.002), "ENTRY: " + str.tostring(tradeEntryPrice, format.price),
        color=color.new(color.yellow, 0), textcolor=color.white, style=label.style_label_center, size=size.small)
    
    // Target label
    label.new(bar_index, tradeTargetPrice + (high * 0.002), "TARGET: " + str.tostring(tradeTargetPrice, format.price),
        color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_center, size=size.small)
    
    // SL label
    label.new(bar_index, tradeStopLossPrice - (high * 0.002), "SL: " + str.tostring(tradeStopLossPrice, format.price),
        color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_center, size=size.small)

// ====================================================================
// PLOT LINES FOR CHART
// ====================================================================

plot(entryLevel, "Today Entry Level", isBullishToday ? color.green : color.red, 2)
plot(tradeActive ? tradeEntryPrice : na, "Active Trade Entry", color.yellow, 3)
plot(tradeActive ? tradeTargetPrice : na, "Target", color.green, 2)
plot(tradeActive ? tradeStopLossPrice : na, "Stop Loss", color.red, 2)

// ====================================================================
// INFO TABLE - CURRENT TRADE STATUS
// ====================================================================

if barstate.islast
    candleColorToday = isBullishToday ? "🟢 GREEN" : "🔴 RED"
    
    t = table.new(position.top_right, 2, 10, border_color=color.white, border_width=2)
    
    // Title
    table.cell(t, 0, 0, "📊 DAILY STRATEGY", bgcolor=color.navy, text_color=color.white, text_size=size.small, width=auto)
    table.cell(t, 1, 0, "STATUS", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    
    // Today's Candle
    table.cell(t, 0, 1, "Today Candle", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, candleColorToday, bgcolor=isBullishToday ? color.new(color.green, 50) : color.new(color.red, 50), text_color=color.white, text_size=size.small)
    
    // Today's Close
    table.cell(t, 0, 2, "Daily Close", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(dailyClose, format.price), bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    
    // Today's Entry Level
    table.cell(t, 0, 3, "Today Entry Level", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(entryLevel, format.price), bgcolor=color.new(color.orange, 50), text_color=color.white, text_size=size.small)
    
    // Current Price
    table.cell(t, 0, 4, "Current Price", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(close, format.price), bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    
    // Trade Status
    tradeStatus = tradeActive ? (tradeType == "BUY" ? "🟢 BUY ACTIVE" : "🔴 SELL ACTIVE") : "⚪ WAITING FOR SIGNAL"
    tradeStatusBg = tradeActive ? (tradeType == "BUY" ? color.new(color.green, 50) : color.new(color.red, 50)) : color.new(color.gray, 50)
    table.cell(t, 0, 5, "Trade Status", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, tradeStatus, bgcolor=tradeStatusBg, text_color=color.white, text_size=size.small)
    
    // Current P/L
    if tradeActive
        currentPLText = str.tostring(tradeCurrentProfit, format.price) + " pts"
        currentPLColor = tradeCurrentProfit >= 0 ? color.new(color.green, 50) : color.new(color.red, 50)
    else
        currentPLText = "-"
        currentPLColor = color.new(color.gray, 50)
    
    table.cell(t, 0, 6, "Current P/L", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, currentPLText, bgcolor=currentPLColor, text_color=color.white, text_size=size.small)
    
    // Entry Price (if active)
    table.cell(t, 0, 7, "Active Entry Price", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 7, tradeActive ? str.tostring(tradeEntryPrice, format.price) : "-", bgcolor=color.new(color.yellow, 50), text_color=color.white, text_size=size.small)
    
    // Target | SL
    table.cell(t, 0, 8, "Target | Stop Loss", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    targetSLText = tradeActive ? str.tostring(tradeTargetPrice, format.price) + " | " + str.tostring(tradeStopLossPrice, format.price) : "-"
    table.cell(t, 1, 8, targetSLText, bgcolor=color.new(color.blue, 50), text_color=color.white, text_size=size.small)
    
    // Trade Days Running
    daysRunning = tradeActive ? (bar_index - tradeBarIndex) : 0
    table.cell(t, 0, 9, "Days Running", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 9, str.tostring(daysRunning), bgcolor=color.new(color.purple, 50), text_color=color.white, text_size=size.small)

// ====================================================================
// BACKTEST RESULTS TABLE
// ====================================================================

if barstate.islast
    winRate = totalTrades > 0 ? (winningTrades / totalTrades) * 100 : 0
    avgProfit = totalTrades > 0 ? totalProfit / totalTrades : 0
    
    bt = table.new(position.bottom_right, 2, 10, border_color=color.white, border_width=2)
    
    table.cell(bt, 0, 0, "📈 BACKTEST RESULTS", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(bt, 1, 0, "", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    
    table.cell(bt, 0, 1, "Total Trades", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(bt, 1, 1, str.tostring(totalTrades), bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.small)
    
    table.cell(bt, 0, 2, "✅ Winning Trades", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(bt, 1, 2, str.tostring(winningTrades), bgcolor=color.new(color.green, 50), text_color=color.white, text_size=size.small)
    
    table.cell(bt, 0, 3, "❌ Losing Trades", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(bt, 1, 3, str.tostring(losingTrades), bgcolor=color.new(color.red, 50), text_color=color.white, text_size=size.small)
    
    table.cell(bt, 0, 4, "🔄 Cost-to-Cost", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(bt, 1, 4, str.tostring(ctcTrades), bgcolor=color.new(color.orange, 50), text_color=color.white, text_size=size.small)
    
    table.cell(bt, 0, 5, "Win Rate %", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(bt, 1, 5, str.tostring(winRate, "0.00") + "%", bgcolor=color.new(color.purple, 50), text_color=color.white, text_size=size.small)
    
    table.cell(bt, 0, 6, "💰 Total Profit/Loss", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    totalPLColor = totalProfit >= 0 ? color.new(color.green, 50) : color.new(color.red, 50)
    table.cell(bt, 1, 6, str.tostring(totalProfit, "0.00") + " pts", bgcolor=totalPLColor, text_color=color.white, text_size=size.small)
    
    table.cell(bt, 0, 7, "Avg Profit/Trade", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    avgPLColor = avgProfit >= 0 ? color.new(color.green, 50) : color.new(color.red, 50)
    table.cell(bt, 1, 7, str.tostring(avgProfit, "0.00") + " pts", bgcolor=avgPLColor, text_color=color.white, text_size=size.small)
    
    table.cell(bt, 0, 8, "📈 Largest Win", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(bt, 1, 8, str.tostring(largestWin, "0.00") + " pts", bgcolor=color.new(color.green, 50), text_color=color.white, text_size=size.small)
    
    table.cell(bt, 0, 9, "📉 Largest Loss", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(bt, 1, 9, str.tostring(largestLoss, "0.00") + " pts", bgcolor=color.new(color.red, 50), text_color=color.white, text_size=size.small)
